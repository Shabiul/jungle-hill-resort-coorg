# Optional override of the public site URL (no trailing slash). Defaults to siteConfig.siteUrl.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification code (the content value of the meta tag)
# NEXT_PUBLIC_GSC_VERIFICATION=

# TODO: add when email / enquiry delivery is wired up
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# ENQUIRY_TO_EMAIL=

# Supabase (server-side only; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated emails allowed into /admin (must also exist as Supabase Auth users)
ADMIN_EMAILS=

# Upstash Redis (optional): shared cache and rate limiting. Without it the site reads Supabase directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Secret for /api/keepalive (keeps the free Supabase and Upstash projects from going idle)
KEEPALIVE_SECRET=
